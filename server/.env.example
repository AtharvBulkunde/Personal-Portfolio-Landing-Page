PORT=3000
# Use a long random secret; never commit your real .env file.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
# Comma-separated frontend origins. Add the deployed portfolio origin here.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
# Optional absolute path for durable SQLite storage:
# DB_PATH=/absolute/path/to/portfolio.sqlite
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
